 src/mod_array.f90        | 89 +++++++++++++++++++++++++++++++++++++++-
 src/mod_inout.f90        |  3 +-
 src/mod_minimize.f90     | 10 +++++
 src/mod_optimize.f90     | 12 +++---
 src/mod_optimize_lym.f90 |  6 +--
 6 files changed, 110 insertions(+), 12 deletions(-)

