From f0a30f4f6bdabaed26d3bb813831829913611c1b Mon Sep 17 00:00:00 2001
From: Denis Andreyev <257564291+unsound-mint@users.noreply.github.com>
Date: Fri, 13 Nov 2026 22:45:58 +0500
Subject: [PATCH 6/6] Skip exp() where it is exactly zero (same result)

exp() of an argument below -745.2 is exactly 0 in double precision. More
than 39 sigma + 2 channels from the line centre the argument is below -760,
so data_term sets those channels to 0 without calling exp(). The vectorised
exp() falls back to slow scalar code for such arguments, and for narrow
Gaussians that is most of the channels.

Output is bit-for-bit the same as before.
---
 src/mod_optimize.f90 | 20 +++++++++++++++++---
 1 file changed, 17 insertions(+), 3 deletions(-)

diff --git a/src/mod_optimize.f90 b/src/mod_optimize.f90
index 2c59e1f..41529e7 100644
--- a/src/mod_optimize.f90
+++ b/src/mod_optimize.f90
@@ -120,14 +120,28 @@ contains
     real(xp), intent(in) :: p(3*n_gauss), line(dim_v), std
     real(xp), intent(out) :: fp, d(3*n_gauss)
 
-    integer :: k, l
-    real(xp) :: rr
+    integer :: k, l, klo, khi
+    real(xp) :: rr, w
     real(xp) :: ee(dim_v, n_gauss), res(dim_v)
 
     res = 0._xp
     do l=1, n_gauss
-       do k=1, dim_v
+       ! exp() is exactly 0 for arguments below -745.2. More than 39*sigma + 2 channels from
+       ! the centre the argument is below -760, so those channels are set to 0 without calling
+       ! exp(): the vectorised exp() falls back to slow scalar code for such arguments, and for
+       ! narrow Gaussians that is most channels. The result is bit-for-bit the same.
+       klo = 1
+       khi = dim_v
+       w = 39._xp * abs(p(3+(3*(l-1)))) + 2._xp
+       if (w < real(dim_v,xp) .and. abs(p(2+(3*(l-1)))) < 1.e6_xp) then
+          klo = max(1, int(p(2+(3*(l-1))) - w))
+          khi = min(dim_v, int(p(2+(3*(l-1))) + w) + 1)
+       end if
+       ee(:,l) = 0._xp
+       do k=klo, khi
           ee(k,l) = exp( ( -(real(k,xp) - p(2+(3*(l-1))))**2) / (2._xp * p(3+(3*(l-1)))**2))
+       end do
+       do k=1, dim_v
           res(k) = res(k) + p(1+(3*(l-1))) * ee(k,l)
        end do
     end do
