Date: Sat, 17 Oct 2026 19:53:20 +0500
Subject: [PATCH] Optional binary input format

ROHSA reads its input cube from a text file with one line per voxel.
For a 2048 x 2048 x 159 cube that is 667 million lines and 20 GB:
parsing it in read_cube takes about 4 minutes on one core (0.36 us per
line), and writing it from Python or Julia several minutes more.

A file name ending in .bin is now read as a binary stream: three 4-byte
integers (nv, ny, nx), then the 8-byte values in Fortran order
cube(v,y,x). The file is a quarter of the size and is read in seconds.
ROHSApy gains cube2bin() to write it. The text format and cube2dat() are
unchanged and remain the default.

The same values give a bit-for-bit identical decomposition from either
format.

---
 README.md                      |  3 +++
 python/ROHSApy/ROHSApy/core.py | 15 +++++++++++++++
 src/mod_inout.f90              | 19 +++++++++++++++++++
 3 files changed, 37 insertions(+)

diff --git a/README.md b/README.md
index 852ace9..46a02d0 100644
--- a/README.md
+++ b/README.md
@@ -14,6 +14,9 @@ All codes used in this work are available [here](https://github.com/antoinemarch
 ## Documentation
 Check out the [online documentation](https://antoinemarchal.github.io/ROHSA/lists/files.html) generated by [FORD](https://github.com/cmacmackin/ford).
 
+## Binary input
+For large cubes, write the input with `core.cube2bin(filename="cube.bin")` instead of `core.cube2dat(...)` and pass that file as `filename`. A name ending in `.bin` makes ROHSA read three 4-byte integers (nv, ny, nx) followed by the 8-byte values in Fortran order `cube(v,y,x)`. The text format stays the default.
+
 ## Getting started
 A google colab notebook is available [here!](https://github.com/antoinemarchal/ROHSA/blob/master/ROHSApy.ipynb) It shows how to install, compile, run and read ROHSA's output.
 
diff --git a/python/ROHSApy/ROHSApy/core.py b/python/ROHSApy/ROHSApy/core.py
index 7228875..866fcb1 100644
--- a/python/ROHSApy/ROHSApy/core.py
+++ b/python/ROHSApy/ROHSApy/core.py
@@ -34,6 +34,21 @@ class ROHSA(object):
                         f.write(line)
 
 
+    def cube2bin(self, filename=None):
+        """Write the cube in ROHSA's binary input format (file name ending in .bin).
+
+        Three int32 (nv, ny, nx) followed by the float64 values in Fortran
+        order cube(v, y, x). Much faster to write and to read than cube2dat.
+        """
+        if not filename : filename = self.filename[:-5] + ".bin" if self.filename is not None else "cube.bin"
+        if not filename.endswith(".bin"): raise ValueError("ROHSA reads the binary format only from a file name ending in .bin")
+        print("Generate " + filename + " file readable by fortran")
+        nv, ny, nx = self.cube.shape
+        with open(filename, 'wb') as f:
+            np.array([nv, ny, nx], dtype='<i4').tofile(f)
+            np.ascontiguousarray(np.transpose(self.cube, (2, 1, 0)), dtype='<f8').tofile(f)
+
+
     def rms_map(self, rms_map, filename=None):
         if not filename :
             print("Generate rms_map.dat file")
diff --git a/src/mod_inout.f90 b/src/mod_inout.f90
index 97cdd62..3d55f9a 100644
--- a/src/mod_inout.f90
+++ b/src/mod_inout.f90
@@ -69,6 +69,25 @@ contains
     character(len=512), intent(in) :: filename
     real(xp), intent(inout), dimension(:,:,:), allocatable :: cube
 
+    ! A file name ending in .bin is read as a binary stream: three 4-byte
+    ! integers nv, ny, nx, then nv*ny*nx 8-byte reals in cube(v,y,x)
+    ! (Fortran) order. It is a quarter of the size of the text format and
+    ! is read in seconds; parsing the text takes about 4 minutes for a
+    ! 2048 x 2048 x 159 cube.
+    nl = len_trim(filename)
+    if (nl > 4) then
+       if (filename(nl-3:nl) == ".bin") then
+          open(unit=11, file=filename, access="stream", form="unformatted", action="read", &
+               status="old", iostat=ios)
+          if (ios /= 0) stop "opening file error"
+          read(11) nv, ny, nx
+          allocate(cube(nv,ny,nx))
+          read(11) cube
+          close(11)
+          return
+       end if
+    end if
+
     open(unit=11, file=filename, action="read", status="old", iostat=ios)
     if (ios /= 0) stop "opening file error"
     
